---
import Book from "../layouts/Book.astro";
import Spread from "../components/Spread.astro";
import { blob, lemma, readRepo, type Row } from "../lib/book";

// Scores and floors come from the tracked baseline and policy at build time.
type Capture = { key: string; fixture: string; mode: string; ssim: number; mismatch: number; renderer: string; chrome: string; xcode: string; sourceRevision: string; capturedAt: string };
const baselinePath = "tests/conformance/baselines/visual-all-ios.json";
const policyPath = "tests/conformance/visual-policy-ios.json";
const baseline: Record<string, Capture> = JSON.parse(readRepo(baselinePath));
const policy: { maxDrop: number; families: Record<string, { minSsim: number }> } = JSON.parse(readRepo(policyPath));

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pairs = [
  { slug: "shadcn-card", key: "shadcn-card-390-light-app", height: 838 },
  { slug: "tw-cards", key: "tw-cards-390-light-app", height: 1169 },
  { slug: "overlay-dialog-open", key: "overlay-dialog-390-light-app@open:edit-profile", height: 1298 },
].map((p) => {
  const c = baseline[p.key];
  if (!c) throw new Error(`${baselinePath} has no capture ${p.key}`);
  const family = `${c.fixture.split("/")[0]}@${c.mode}`;
  return { ...p, c, family, floor: policy.families[family]!.minSsim };
});

const ref = pairs[0]!.c;
const device = ref.renderer.replace(/ com\.apple\.CoreSimulator.*$/, "");
const ios = ref.renderer.replace(/^.*SimRuntime\.iOS-(\d+)-(\d+)$/, "iOS $1.$2");
const browser = ref.chrome.replace(/^Chromium/, "Chrome");
const xcode = ref.xcode.split("\n")[0];
const count = Object.keys(baseline).length;

const rows: Row[] = pairs.map(({ slug, c, height }) => [
  { src: `${base}evidence/${slug}-chrome.webp`, alt: `${browser} rendering of ${c.fixture} at 390 px`, width: 600, height },
  { src: `${base}evidence/${slug}-swiftui.webp`, alt: `SwiftUI rendering of the view generated from ${c.fixture}, ${device}, ${ios}`, width: 600, height },
]);

const notes: Array<[number | number[] | string, string]> = [
  ...pairs.map(({ c, family, floor }, i): [number, string] => [
    i + 1,
    lemma(
      `<code>${c.key}</code>`,
      `SSIM <strong class="num">${c.ssim.toFixed(4)}</strong>, mismatch <span class="num">${c.mismatch.toFixed(4)}</span>; <code>${family}</code> floor <span class="num">${floor.toFixed(2)}</span>`,
    ),
  ]),
  ["Rule", lemma("a capture fails", `below its family floor, or <span class="num">${policy.maxDrop}</span> under its own baseline`)],
  [
    "Run",
    lemma(
      `${browser}, ${device}, ${ios}`,
      `${xcode}; revision <code>${ref.sourceRevision.slice(0, 7)}</code>, ${ref.capturedAt.slice(0, 10)}; scores from <a href="${blob(baselinePath)}"><code>${baselinePath}</code></a>, floors from <a href="${blob(policyPath)}"><code>${policyPath}</code></a>`,
    ),
  ],
];
const floors = Object.entries(policy.families).sort(([a], [b]) => a.localeCompare(b));
---

<Book at={6} description="Verification: every conformance fixture rendered by Chrome and by the generated SwiftUI on iOS, scored with colour SSIM against ratcheted floors.">
  <header class="opening">
    <div class="lede">
      <h1><span class="no">7</span>Verification: both renders, scored</h1>
      <p>
        Every conformance fixture is rendered twice: by Chrome, and by the generated SwiftUI in the iOS simulator
        (<code>UIHostingController</code> and <code>drawHierarchy</code>). The two images are compared with colour SSIM,
        the minimum over red, green and blue at 1×, both decoded to sRGB.
      </p>
      <p>
        The tracked baseline holds {count} captures. Each family has a floor that <code>bun run quality --ratchet</code>
        raises after a reviewed rebaseline and never lowers. The verso shows Chrome, the recto SwiftUI; the scores are
        read from the baseline this site was built from.
      </p>
    </div>
  </header>

  <Spread
    id="verification"
    verso={{ label: "Chrome · verso", note: browser }}
    recto={{ label: "SwiftUI · recto", note: `${device}, ${ios}` }}
    rows={rows}
    notes={notes}
    lit={1}
  />

  <section class="apparatus" aria-labelledby="floors">
    <h2 id="floors" class="sc">Floors</h2>
    <ul class="floors">
      {
        floors.map(([family, { minSsim }]) => (
          <li>
            <code>{family}</code>
            <span class="num">{minSsim.toFixed(2)}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Book>
