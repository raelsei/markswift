---
import { createHash } from "node:crypto";
import Book from "../layouts/Book.astro";
import Spread from "../components/Spread.astro";
import { type Row } from "../lib/book";
import tokens from "../artifacts/WelcomeCard+Tokens.swift?raw";
import runtime from "../artifacts/MarkswiftRuntime.swift?raw";

const lines = runtime.trimEnd().split("\n").length;
const sha = createHash("sha256").update(runtime).digest("hex");
const layouts = [...runtime.matchAll(/^(?:nonisolated )?struct (Markswift\w+): Layout \{/gm)].map((m) => m[1]);

const rows: Row[] = [
  ["## WelcomeCard+Tokens.swift", "## MarkswiftRuntime.swift"],
  [
    "// Generated by Markswift 2.0.0 — colour tokens paired from the light and dark captures of one page.",
    "// Generated by Markswift 2.0.0 — runtime helpers shared by all generated views.",
  ],
  ["// …", "import SwiftUI"],
  ["// An adaptive token is Color.markswift(light:dark:) and follows the colour scheme; a static token", "// …"],
  ["// is the same colour in both themes.", ""],
  ["//", ""],
  ["// 2 tokens: 0 adaptive (light/dark pairs), 2 static.", ""],
  ["// 4 colour slots carry them; 0 single-use colours identical in both themes stay inline.", ""],
  ["// …", ""],
  ["extension WelcomeCard {", "extension Color {"],
  ["    enum Palette {", ""],
  ["        /// canvas · 2 uses", "    /// sRGB components 0…1, as measured from the design's computed styles."],
  [
    "        static let canvas = Color.markswift(0.957, 0.957, 0.961)",
    "    nonisolated static func markswift(_ r: Double, _ g: Double, _ b: Double, _ a: Double = 1) -> Color {",
  ],
  ["        /// text · 2 uses", "        Color(.sRGB, red: r, green: g, blue: b, opacity: a)"],
  ["        static let textBlack = Color.markswift(0.0, 0.0, 0.0)", "    }"],
  ["    }", "    /// Light/dark pair as one colour, resolved per `UITraitCollection.userInterfaceStyle`: it"],
  ["}", "    /// follows the system appearance, `.preferredColorScheme` and `\\.colorScheme`."],
  ["", "    nonisolated static func markswift(light: Color, dark: Color) -> Color {"],
  ["", "// …"],
];

const notes: Array<[number | number[] | string, string]> = [
  [1, "Both files open with the version that wrote them."],
  [[3, 4, 17], "A colour that differs between the light and the dark capture becomes <code>Color.markswift(light:dark:)</code>, which follows the colour scheme."],
  [[6, 7], "This card was captured in both themes and its colours agree, so both tokens are static."],
  [[9, 10], "Tokens are nested in the view’s type, so several conversions can share one target."],
  [[11, 13], "Each doc comment names the role and the number of colour slots that use it."],
  [[12, 13, 14], "A token is a call into the runtime: sRGB components 0 to 1, from the colour Chrome computed."],
  ["File", `${lines} lines, SHA-256 <code>${sha.slice(0, 16)}…</code>: byte-identical in the three conversions and the package build behind this book.`],
  ["Layouts", `${layouts.map((l) => `<code>${l}</code>`).join(", ")}.`],
];
---

<Book at={5} description="The runtime: one shared Swift file of colour helpers, modifiers, layouts and the animation clock that generated views call into.">
  <header class="opening">
    <div class="lede">
      <h1><span class="no">6</span>Runtime: what the view calls into</h1>
      <p>
        Generated views lean on one shared file, <code>MarkswiftRuntime.swift</code>: colour helpers, line-height and
        font modifiers, the custom layouts that reproduce what SwiftUI’s stacks cannot (measured frames, CSS grid
        tracks, unequal flex growth, tables), and the clock that plays CSS animations.
      </p>
      <p>
        Its header names the Markswift version, and every conversion by that version writes the identical file; add it
        to a target once. Colours become tokens in the view’s <code>Palette</code>: static when both captures agree,
        light/dark pairs when they differ. The recto follows one token into the runtime.
      </p>
    </div>
    <aside class="provenance" aria-labelledby="set-from">
      <h2 id="set-from" class="sc">Set from</h2>
      <p>
        Both pages are files of the <code>generated-welcome</code> directory from chapter 5’s run. The runtime is
        compared across all four runs by SHA-256.
      </p>
    </aside>
  </header>

  <Spread
    id="runtime"
    verso={{ label: "Tokens · verso", note: "the view’s palette", sources: { "WelcomeCard+Tokens.swift": tokens } }}
    recto={{ label: "Runtime · recto", note: "shared by every view", sources: { "MarkswiftRuntime.swift": runtime } }}
    rows={rows}
    notes={notes}
  />
</Book>
