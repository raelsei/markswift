---
import Book from "../layouts/Book.astro";
import Spread from "../components/Spread.astro";
import { checkVerbatim, code, layoutDocVersion, lemma, version, type Row } from "../lib/book";
import layout from "../artifacts/WelcomeCard.layout.json?raw";
import script from "../artifacts/recompile.ts?raw";
import stdout from "../artifacts/recompile.out.txt?raw";
import swift from "../artifacts/WelcomeCard.recompiled.swift?raw";

const call = [
  `const saved = JSON.parse(readFileSync("WelcomeCard.layout.json", "utf8"));`,
  `const again = compileLayout(saved, { name: "WelcomeCard" });`,
  "// …",
  `  compileLayout({ ...saved, version: 3 }, { name: "WelcomeCard" });`,
];
checkVerbatim(["## recompile.ts", ...call], { "recompile.ts": script }, "layoutdoc provenance");

const stdoutName = "stdout of recompile.ts";
const swiftName = "WelcomeCard.swift, recompiled";
const rows: Row[] = [
  ["## WelcomeCard.layout.json", `## ${stdoutName}`],
  ["{", `[ "WelcomeCard.swift", "MarkswiftRuntime.swift", "WelcomeCard+Tokens.swift" ]`],
  [
    `  "version": 4,`,
    "LayoutDoc version 3 cannot be compiled by Markswift 2.0.0, which reads LayoutDoc version 4; capture the source again.",
  ],
  ["", `## ${swiftName}`],
  [
    `  "source": "welcome.html",`,
    "// Generated by Markswift 2.0.0 — tool-owned: regenerate with `markswift convert --update`; customise through the initializer or your own files. Source: welcome.html (WelcomeCard-light, light)",
  ],
  [`  "combo": {`, "import SwiftUI"],
  [`    "screen": "WelcomeCard",`, "struct WelcomeCard: View {"],
  [`    "theme": "light"`, "// …"],
  ["  },", ""],
  [`  "size": {`, `#Preview("WelcomeCard") {`],
  [`    "w": 368,`, "    WelcomeCard()"],
  [`    "h": 149`, "    .frame(width: 368.0, height: 149.0)"],
  ["  },", "    .background(Color.markswift(0.957, 0.965, 0.98))"],
  [`  "viewport": {`, "    .preferredColorScheme(.light)"],
  [`    "x": -8,`, "}"],
  [`    "y": -8,`, ""],
  [`    "w": 390,`, ""],
  [`    "h": 844`, ""],
  ["  },", ""],
  [`  "conditions": [],`, ""],
  [`  "dpr": 1,`, ""],
  [`  "canvas": "rgb(244, 244, 245)",`, ""],
  [`  "fonts": [],`, ""],
  [`  "root": {`, ""],
  ["  …", ""],
];

const notes: Array<[number | number[] | string, string]> = [
  [1, lemma("saved file, Chrome closed", "the same three files; the view body identical to the CLI run’s")],
  [2, lemma(`<code>"version": ${layoutDocVersion}</code>`, "a schema literal; a document marked 3 is refused: capture again")],
  [[3, 5, 6], lemma("source, screen, theme", "named in the header; the type name comes from <code>--name</code>")],
  [[6, 12], lemma("<code>\"theme\": \"light\"</code>", "one light preview; the CLI run captured both themes and writes two")],
  [[8, 9, 10], lemma("<code>size</code>", "the root’s CSS px size; frames the preview")],
  [[13, 14], lemma("<code>viewport</code>", "root coordinates: the root sat 8 px in, the body’s default margin")],
  [18, lemma("<code>conditions</code>", "size <code>@media</code>/<code>@container</code> rules that hit elements; none")],
  [21, lemma("<code>fonts</code>", "the page’s <code>@font-face</code> faces; none, so no <code>Fonts/</code> folder")],
  ["Run", lemma(`<code>recompile.ts</code>`, `${call.map((l) => code(l.trim())).join("<br>")}; run with Bun against the library`)],
];
---

<Book at={2} description="LayoutDoc: the frozen, versioned capture document Markswift compiles from, and recompiles without a browser.">
  <header class="opening">
    <div class="lede">
      <h1><span class="no">3</span>LayoutDoc: the capture, written down</h1>
      <p>
        Capture writes one JSON document, the LayoutDoc. A schema checks its shape whenever it is compiled, and its
        <code>version</code> is pinned: a change to the captured style list or the schema bumps it and is a breaking
        release.
      </p>
      <p>
        A saved LayoutDoc compiles without a browser through <code>compileLayout</code>. It is a cache, not an
        interchange format: Markswift {version} compiles only LayoutDoc {layoutDocVersion} and refuses any other with
        an error naming both versions. The verso is the head of the card’s document; the recto is what the library
        made of it with Chrome closed.
      </p>
    </div>
  </header>

  <Spread
    id="layoutdoc"
    verso={{ label: "LayoutDoc · verso", note: "the saved capture", sources: { "WelcomeCard.layout.json": layout } }}
    recto={{ label: "compileLayout · recto", note: "no browser", sources: { [stdoutName]: stdout, [swiftName]: swift } }}
    rows={rows}
    notes={notes}
    lit={2}
  />
</Book>
