---
import Book from "../layouts/Book.astro";
import Spread from "../components/Spread.astro";
import { lemma, runEntry, type Row } from "../lib/book";
import ir from "../artifacts/WelcomeCard.ir.json?raw";
import swift from "../artifacts/WelcomeCard.swift?raw";
import transcript from "../artifacts/transcript.txt?raw";

const rows: Row[] = [
  ["## WelcomeCard.ir.json", "## WelcomeCard.swift"],
  [`"root": {`, "struct WelcomeCard: View {"],
  ["  …", "    @ScaledMetric(relativeTo: .callout) private var textSize16: CGFloat = 16.0"],
  ["", "    @ScaledMetric(relativeTo: .title2) private var textSize24: CGFloat = 24.0"],
  ["", "    // …"],
  ["", "    private var v_root: some View {"],
  [`  "kind": "stack",`, "        VStack(alignment: .leading, spacing: 19.9) {"],
  [`  "axis": "v",`, ""],
  [`  "spacing": 19.9,`, ""],
  [`  "align": "stretch",`, ""],
  ["  …", ""],
  [`  "leadInset": 19.91,`, ""],
  ["  …", ""],
  [
    `      "text": "Hello SwiftUI",`,
    `            Text(verbatim: "Hello SwiftUI").font(.system(size: textSize24, weight: .bold, design: .default)).foregroundStyle(Palette.textBlack)`,
  ],
  ["      …", "            .fixedSize(horizontal: false, vertical: true)"],
  [`        "size": 24,`, "            .frame(minWidth: 0.0, maxWidth: .infinity, alignment: .leading)"],
  [`        "weight": 700`, "            .accessibilityAddTraits(.isHeader)"],
  ["      …", "            .accessibilityHeading(.h2)"],
  ["", "            .padding(.top, 19.91)"],
  [
    `      "text": "Made from HTML.",`,
    `            Text(verbatim: "Made from HTML.").font(.system(size: textSize16, weight: .regular, design: .default)).foregroundStyle(Palette.textBlack)`,
  ],
  ["      …", "            .fixedSize(horizontal: false, vertical: true)"],
  [`        "size": 16,`, "            .frame(minWidth: 0.0, maxWidth: .infinity, alignment: .leading)"],
  [`        "weight": 400`, "        }"],
  ["", "        .padding(EdgeInsets(top: 24.0, leading: 24.0, bottom: 40.0, trailing: 24.0))"],
  ["", "        .frame(minWidth: 0.0, maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)"],
  ["", "        .background(Palette.canvas, in: RoundedRectangle(cornerRadius: 16.0, style: .circular))"],
  ["", "    }"],
];

const notes: Array<[number | number[] | string, string]> = [
  [[1, 5], lemma("<code>\"root\"</code>", "the view: <code>struct WelcomeCard</code> (<code>--name</code>) and <code>v_root</code> (node id)")],
  [[2, 3, 15, 21], lemma("<code>\"size\"</code>", "<code>@ScaledMetric</code> relative to a text style: follows Dynamic Type")],
  [[6, 7, 8], lemma("<code>stack</code>, <code>v</code>, <code>19.9</code>", "<code>VStack(spacing: 19.9)</code>")],
  [[9, 15, 21], lemma("<code>stretch</code>", "<code>.leading</code>, each child <code>maxWidth: .infinity</code>")],
  [[11, 18], lemma("<code>leadInset</code>", "<code>.padding(.top, 19.91)</code> on the first child")],
  [[13, 19], lemma("<code>\"text\"</code>", "<code>Text(verbatim:)</code>: words as written, never a localization key")],
  [[14, 20], lemma("app mode", "text wraps to the offered width and takes the height it needs")],
  [[16, 22], lemma("<code>700</code>, <code>400</code>", "<code>.bold</code>, <code>.regular</code>")],
  [17, lemma("heading 2 (chapter 4, line 27)", "<code>.isHeader</code> and <code>.accessibilityHeading(.h2)</code>")],
  [23, lemma("padding (chapter 4, lines 3–8)", "<code>EdgeInsets</code>, top, leading, bottom, trailing")],
  [25, lemma("fill, radius 16", "<code>Palette.canvas</code> (chapter 6) in a <code>RoundedRectangle</code>")],
  [
    "Run",
    runEntry(
      transcript,
      "npx markswift convert welcome.html --name WelcomeCard --out ./generated-welcome",
      "; the recto byte for byte what the library returned as <code>code</code>",
    ),
  ],
];
---

<Book at={4} description="SwiftUI: how Markswift emits a view from the semantic IR, with Dynamic Type, explicit init and native stacks.">
  <header class="opening">
    <div class="lede">
      <h1><span class="no">5</span>SwiftUI: the view it writes</h1>
      <p>
        The emitter walks the IR and writes one SwiftUI view: stacks become <code>VStack</code> and
        <code>HStack</code> or a runtime layout, text becomes <code>Text</code>, controls become native controls. In
        <code>app</code> mode, the default, sizes are floors rather than pins: text scales with Dynamic Type through
        <code>@ScaledMetric</code>, and boxes grow with their text.
      </p>
      <p>
        The view has an explicit <code>init</code>. Repeated rows become a <code>ForEach</code> over a data array and
        buttons become <code>on&lt;Name&gt;</code> closures; this card has neither. Every <code>.swift</code> file
        starts with the version line that wrote it.
      </p>
    </div>
  </header>

  <Spread
    id="swiftui"
    verso={{ label: "Semantic IR · verso", note: "what it means", sources: { "WelcomeCard.ir.json": ir } }}
    recto={{ label: "SwiftUI · recto", note: "what Markswift wrote", sources: { "WelcomeCard.swift": swift } }}
    rows={rows}
    notes={notes}
    lit={7}
  />
</Book>
