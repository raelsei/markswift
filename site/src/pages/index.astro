---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { Code } from "astro:components";
import "../styles/site.css";
import Evidence from "../components/Evidence.astro";
import hello from "../samples/hello.swift?raw";
import teamCards from "../samples/team-cards.swift?raw";
import teamCardsRow from "../samples/team-cards-row.swift?raw";
import teamCardsTokens from "../samples/team-cards-tokens.swift?raw";
import deleteDialog from "../samples/delete-dialog.swift?raw";
import editProfile from "../samples/edit-profile.swift?raw";

// The page reads its numbers from the repository it documents, at build time.
const repo = resolve(process.cwd(), "..");
const read = (path: string) => readFileSync(resolve(repo, path), "utf8");
const pkg = JSON.parse(read("package.json"));
type Capture = { key: string; fixture: string; mode: string; ssim: number; chrome: string; xcode: string; renderer: string; sourceRevision: string; capturedAt: string };
const baseline: Record<string, Capture> = JSON.parse(read("tests/conformance/baselines/visual-all-ios.json"));
const policy = JSON.parse(read("tests/conformance/visual-policy-ios.json"));
const behaviour = JSON.parse(read("tests/conformance/ios-behaviour.json"));

const block = read("README.md").split("<!-- quality-summary")[1]!.split("<!-- /quality-summary -->")[0]!;
const quality = block
  .split("\n")
  .filter((l) => /^\| [a-z]/.test(l) && !l.startsWith("| domain"))
  .map((l) => {
    const [domain, mode, n, mean, min, mismatch, anchors] = l.split("|").slice(1, -1).map((s) => s.trim());
    const [minValue, minCase] = min!.split(" ");
    const floor = policy.families[`${domain}@${mode}`]?.minSsim as number | undefined;
    return { domain, mode, n, mean, minValue, minCase: minCase?.replace(/[()]/g, ""), mismatch, anchors, floor };
  });
// Policy exceptions are capture keys or `<case>@<mode>` patterns covering every width and theme of a case.
const excepted = (e: Capture) =>
  Object.keys(policy.exceptions).some((x) => {
    if (x === e.key) return true;
    const [c, mode] = x.split("@");
    return mode === e.mode && !/-\d+-/.test(x) && new RegExp(`^${c}-\\d+-`).test(e.key);
  });
const componentsApp = Object.values(baseline).filter((e) => e.mode === "app" && e.fixture.startsWith("components/"));
const exceptions = componentsApp.filter(excepted).length;

const entries = Object.values(baseline);
const count = (mode: string, min = 0) => entries.filter((e) => e.mode === mode && e.ssim >= min).length;
const totals = {
  all: entries.length,
  app: count("app"),
  fidelity: count("fidelity"),
  app95: count("app", 0.95),
  fidelity95: count("fidelity", 0.95),
};
const ref = baseline["shadcn-card-390-light-app"]!;
const iosRuntime = ref.renderer.replace(/^.* com\.apple\.CoreSimulator\.SimRuntime\.iOS-(\d+)-(\d+)$/, "iOS $1.$2");
const device = ref.renderer.replace(/ com\.apple\.CoreSimulator.*$/, "");
const xcode = ref.xcode.split("\n")[0];

const github = "https://github.com/raelsei/markswift";
const npm = "https://www.npmjs.com/package/markswift";
const changelog = `${github}/blob/main/CHANGELOG.md`;
const readmeUrl = `${github}#readme`;
const blob = (path: string) => `${github}/blob/main/${path}`;
const tree = (path: string) => `${github}/tree/main/${path}`;

const sections = [
  ["start", "Quick start"],
  ["pipeline", "Pipeline"],
  ["modes", "Modes"],
  ["components", "Components"],
  ["two", "New in 2.0"],
  ["verification", "Verification"],
  ["limits", "Limits"],
] as const;

const install = "npm install --save-dev markswift\nnpx markswift --version";
const quick = `printf '%s\\n' '<main data-markswift-root style="width:240px;height:80px;font:18px system-ui">Hello Markswift</main>' \\
  | npx markswift convert - --name HelloCard --out ./generated-hello
# Wrote 3 files for HelloCard to ./generated-hello`;
const api = `import { convertHtml } from "markswift";

const result = await convertHtml(
  '<article data-markswift-root class="card"><h2>Hello SwiftUI</h2><p>Made from HTML.</p></article>',
  {
    name: "WelcomeCard",
    css: \`
      body { margin: 0; }
      .card { width: 320px; padding: 24px; background: #f4f4f5; border-radius: 16px; }
      h2, p { font-family: system-ui; }
    \`,
  },
);
// result.files: every Swift source · result.assets: fonts and images
// result.diagnostics: what the capture lost · result.layout: the LayoutDoc`;
const usage = `TeamCards()                                                    // the design as captured
TeamCards(onMessage: { card in print("message", card.title) }) // card: TeamCards.InviteATeammateCard`;
const naming = `<h2 data-markswift-field="title">Team members</h2>
<ul>
  <li data-markswift-component="Member">
    <span data-markswift-field="name">Ada</span> <span data-markswift-field="role">Owner</span>
  </li>
</ul>`;
const library = `{
  "library": "ShadcnKit",
  "out": "ShadcnKit",
  "serve": "fixtures",
  "root": "[data-markswift-root]",
  "theme": "adaptive",
  "components": [
    { "name": "AccordionView", "source": "fixtures/components/shadcn-accordion.html" },
    { "name": "CardView", "source": "fixtures/components/shadcn-card.html", "theme": "light" }
  ]
}`;
const palette = `{
  "--primary": "Color.accentColor",
  "#e2e8f0": "Color(\\"Border\\")",
  "#ffffff/#0a0a0a": "Color(\\"Card\\")"
}`;
const breakpoints = "npx markswift convert ./page.html --breakpoints auto --name Settings --out ./generated";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Markswift: HTML and CSS to SwiftUI, measured against Chrome</title>
    <meta
      name="description"
      content="Markswift captures rendered HTML and CSS in Chrome and writes reusable SwiftUI components for iOS 18+. How it works, how to use it, and how its output is verified."
    />
    <meta name="theme-color" content="#fdfdfc" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(import.meta.env.BASE_URL, Astro.site).href} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="head">
      <div class="head-inner">
        <a class="mark" href="#top">Markswift<span>{pkg.version}</span></a>
        <nav aria-label="Sections">
          <ul class="index">
            {sections.map(([id, label]) => <li><a href={`#${id}`} data-index>{label}</a></li>)}
          </ul>
        </nav>
        <div class="out">
          <a href={github}>GitHub</a>
          <a href={npm}>npm</a>
          <a href={changelog}>Changelog</a>
        </div>
      </div>
    </header>

    <main id="content">
      <section class="hero" id="top" aria-labelledby="title">
        <div>
          <h1 id="title"><span>HTML and CSS in.</span> <span>SwiftUI out.</span> <span>Scored against Chrome.</span></h1>
          <p class="lede">
            Markswift renders a page or component in Chrome, records what the browser laid out, and writes SwiftUI for
            iOS&nbsp;18+ and Swift&nbsp;6 that looks like that rendering and can be reused: an explicit <code>init</code>,
            repeated rows as a <code>ForEach</code>, every button an <code>on&lt;Name&gt;</code> closure.
          </p>
          <dl class="facts">
            <dt>Release</dt>
            <dd>{pkg.version} · LayoutDoc 4</dd>
            <dt>Output</dt>
            <dd>SwiftUI for iOS 18+, Swift 6</dd>
            <dt>Runs on</dt>
            <dd>Node.js ≥ 20 or Bun ≥ 1.4.2, with Google Chrome installed</dd>
            <dt>License</dt>
            <dd>MIT</dd>
          </dl>
          <div class="cmd">
            <span class="cmd-label">Install</span>
            <pre><code>{install}</code></pre>
          </div>
          <div class="cmd">
            <span class="cmd-label">Convert a page</span>
            <pre><code>npx markswift convert ./page.html --name Card --out ./generated</code></pre>
          </div>
        </div>
        <Evidence slug="shadcn-card" wipe eager>
          The shadcn/ui card fixture, rendered by Chrome and by the SwiftUI view Markswift generated from it, on the iOS
          simulator. Drag the cut to compare.
        </Evidence>
      </section>

      <section class="sec" id="start" aria-labelledby="start-h">
        <div class="sec-head">
          <h2 id="start-h">Quick start</h2>
          <ul class="sources">
            <li><a href={blob("src/cli.ts")}>src/cli.ts</a></li>
            <li><a href={tree("src/api")}>src/api/</a></li>
            <li><a href={blob("src/index.ts")}>src/index.ts</a></li>
          </ul>
        </div>
        <div class="sec-body">
          <div class="prose">
            <p>
              You need Node.js ≥ 20 or Bun ≥ 1.4.2 and an installed Google Chrome. <code>python3</code> with
              <code>fontTools</code> and <code>brotli</code> bundles webfonts; without them the conversion still completes
              and reports each font it could not bundle. Xcode is needed only to compile the generated Swift.
            </p>
          </div>
          <div class="block">
            <span class="label">Command line</span>
            <Code code={quick} lang="sh" theme="css-variables" />
          </div>
          <div class="prose">
            <p>
              <code>--out</code> must not exist yet; regenerate later with <code>--update</code>. Other inputs: a file
              (<code>npx markswift convert ./page.html --out ./out</code>, relative assets resolve beside it),
              <code>--css ./compiled.css</code> for a separate compiled stylesheet, and
              <code>--url http://localhost:5173/card --root '#preview'</code> for a running page.
            </p>
          </div>
          <div class="block">
            <span class="label">HelloCard.swift, as written by the command above</span>
            <Code code={hello} lang="swift" theme="css-variables" />
          </div>

          <div class="table-wrap">
            <table>
              <caption>Main options of <code>convert</code> (<code>npx markswift convert --help</code> lists all)</caption>
              <thead><tr><th scope="col">Option</th><th scope="col">Default</th><th scope="col">Effect</th></tr></thead>
              <tbody>
                <tr><th scope="row"><code>--name</code></th><td><code>ConvertedView</code></td><td>Swift type name of the view</td></tr>
                <tr><th scope="row"><code>--root</code></th><td><code>[data-markswift-root]</code>, else <code>body</code></td><td>Element to convert</td></tr>
                <tr><th scope="row"><code>--width</code>, <code>--height</code></th><td>390 × 844</td><td>Capture viewport</td></tr>
                <tr><th scope="row"><code>--mode</code></th><td><code>app</code></td><td><code>app</code> reflows; <code>fidelity</code> pins captured geometry</td></tr>
                <tr><th scope="row"><code>--theme</code></th><td><code>adaptive</code></td><td>Light and dark captures paired into tokens; or <code>light</code>, <code>dark</code></td></tr>
                <tr><th scope="row"><code>--dark-class</code></th><td>none</td><td>Class added to <code>&lt;html&gt;</code> for the dark capture</td></tr>
                <tr><th scope="row"><code>--breakpoints</code></th><td>off</td><td><code>auto</code> or <code>W[xH],…</code>: one capture per CSS width band, one view that switches</td></tr>
                <tr><th scope="row"><code>--palette</code></th><td>none</td><td>Map generated colour tokens to your app's colours</td></tr>
                <tr><th scope="row"><code>--update</code></th><td>off</td><td>Rewrite a previous output in place; refuses hand-edited files (exit 2)</td></tr>
              </tbody>
            </table>
          </div>

          <div class="table-wrap">
            <table>
              <caption>What one conversion writes</caption>
              <thead><tr><th scope="col">File</th><th scope="col">When</th></tr></thead>
              <tbody>
                <tr><th scope="row"><code>&lt;Name&gt;.swift</code></th><td>Always: the view with an explicit <code>init</code>, light and dark <code>#Preview</code>s, extracted row types, data and subviews</td></tr>
                <tr><th scope="row"><code>&lt;Name&gt;+Tokens.swift</code></th><td>Always: colours in <code>&lt;Name&gt;.Palette</code></td></tr>
                <tr><th scope="row"><code>MarkswiftRuntime.swift</code></th><td>Always: shared layouts and helpers, identical for every conversion by the same version</td></tr>
                <tr><th scope="row"><code>&lt;Name&gt;+Shapes.swift</code></th><td>When SVG or clip shapes exist</td></tr>
                <tr><th scope="row"><code>&lt;Name&gt;+Fonts.swift</code>, <code>Fonts/*.ttf</code></th><td>When webfonts were bundled</td></tr>
                <tr><th scope="row"><code>Images/&lt;hash&gt;.&lt;ext&gt;</code></th><td>When the component shows raster images</td></tr>
                <tr><th scope="row"><code>.markswift.json</code></th><td>Always: the manifest <code>--update</code> reads (tool, version, SHA-256 of every file written)</td></tr>
              </tbody>
            </table>
          </div>

          <h3>Library API</h3>
          <div class="block">
            <Code code={api} lang="ts" theme="css-variables" />
          </div>
          <div class="prose">
            <ul>
              <li><code>convert(source, options)</code> takes <code>{"{ file }"}</code>, <code>{"{ url }"}</code> or <code>{"{ html, baseURL?, assetsDir? }"}</code>; <code>convertHtml(html, options)</code> is the string shorthand.</li>
              <li><code>compileLayout(layout, {"{ name, mode, dark }"})</code> recompiles a saved LayoutDoc 4 without Chrome; it does not package fonts. With <code>variants</code> it compiles saved width-band captures into one view.</li>
              <li><code>buildLibrary(…)</code> and <code>compileLayouts(…)</code> are the library forms of <code>markswift build</code>.</li>
              <li>For pasted markup, <code>untrustedInput: true</code> blocks page scripts, outbound requests and DNS in the capture browser. Otherwise capture runs the input's scripts: convert trusted inputs only.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="sec" id="pipeline" aria-labelledby="pipeline-h">
        <div class="sec-head">
          <h2 id="pipeline-h">Pipeline</h2>
          <ul class="sources">
            <li><a href={blob("src/api/convert.ts")}>src/api/convert.ts</a></li>
            <li><a href={blob("src/compiler/index.ts")}>src/compiler/index.ts</a></li>
          </ul>
        </div>
        <div class="sec-body">
          <div class="prose">
            <p>
              One conversion runs four stages. Only the first needs a browser: everything after the LayoutDoc is a pure,
              synchronous compilation that <code>compileLayout</code> exposes on its own.
            </p>
          </div>
          <ol class="route">
            <li class="stop">
              <h3>Capture<span class="where"><a href={tree("src/browser")}>src/browser/</a></span></h3>
              <div class="what">
                <p>
                  Headless Chrome through Playwright. CDP <code>DOMSnapshot.captureSnapshot</code> returns the laid-out
                  DOM with a whitelisted set of computed styles, document bounds and paint order
                  (<code>snapshot.ts</code>). Further passes record pressed and focused looks (<code>states.ts</code>),
                  each discovered trigger's open layer in a fresh page (<code>layers.ts</code>, at most 12), CSS animations
                  and transitions from Chrome's Web Animations objects (<code>motion.ts</code>), fonts and images.
                </p>
                <p class="yields">
                  <b>Runs</b> once with <code>prefers-color-scheme: light</code> and once with <code>dark</code>, and with
                  <code>--breakpoints</code> once per CSS width band.
                </p>
              </div>
            </li>
            <li class="stop">
              <h3>LayoutDoc 4<span class="where"><a href={blob("src/model/layout.ts")}>src/model/layout.ts</a></span></h3>
              <div class="what">
                <p>
                  The serializable capture: node tree, computed styles, bounds, viewport, the page's
                  <code>@media</code>/<code>@container</code> conditions, open layers, states and motion. The schema is
                  versioned (<code>LAYOUT_DOC_VERSION = 4</code>) and frozen with 2.0: <code>compileLayout</code> rejects any
                  other version with an error naming both.
                </p>
                <p class="yields"><b>Is</b> a cache you can save and recompile without Chrome, not an interchange format.</p>
              </div>
            </li>
            <li class="stop">
              <h3>Semantic IR<span class="where"><a href={tree("src/analysis")}>src/analysis/</a> → <a href={blob("src/model/semantic.ts")}>semantic.ts</a></span></h3>
              <div class="what">
                <p>
                  <code>inferScreen</code> (<code>infer.ts</code>) turns geometry into intent: stacks, grids, flex rows,
                  tables, text runs, controls, images and SVG. It names things from the markup, admits only the layouts the
                  runtime can reproduce (grid tracks, flex rows, tables), checks them against the capture, and pins the rest
                  to captured geometry. Layers, width bands and motion attach here.
                </p>
                <p class="yields"><b>Reports</b> every loss per node as <code>approximated</code> or <code>unmapped</code> in <code>diagnostics</code>.</p>
              </div>
            </li>
            <li class="stop">
              <h3>SwiftUI emitter<span class="where"><a href={tree("src/swift")}>src/swift/</a></span></h3>
              <div class="what">
                <p>
                  Writes the view: the explicit <code>init</code>, extracted row types and <code>ForEach</code>,
                  <code>on&lt;Name&gt;</code> actions, <code>@ScaledMetric</code> text sizes for Dynamic Type, a
                  <code>Palette</code> of light/dark tokens (<code>src/swift/tokens/</code>), shapes and bundled fonts.
                </p>
                <p class="yields"><b>Writes</b> <code>&lt;Name&gt;.swift</code>, <code>+Tokens</code>, <code>+Shapes</code>, <code>+Fonts</code>.</p>
              </div>
            </li>
            <li class="stop terminus">
              <h3>Runtime<span class="where"><a href={tree("src/swift/runtime")}>src/swift/runtime/</a></span></h3>
              <div class="what">
                <p>
                  The layouts the generated code calls, shipped as one <code>MarkswiftRuntime.swift</code>:
                  <code>MarkswiftBands</code> (width bands), <code>MarkswiftTracks</code> (CSS grid),
                  <code>MarkswiftTable</code>, <code>MarkswiftFlexRow</code>, <code>MarkswiftAnimation</code> and
                  <code>MarkswiftReveal</code> (motion), <code>.markswiftPresentation</code> (drawn overlays).
                </p>
              </div>
            </li>
          </ol>
          <p class="branch">
            Off the line, verification: <a href={tree("tools/verify")}>tools/verify/</a> renders the generated view
            natively and <a href={blob("tools/quality.ts")}>tools/quality.ts</a> scores it against Chrome's screenshot.
            <a href="#verification">How that gate works</a>.
          </p>
        </div>
      </section>

      <section class="sec" id="modes" aria-labelledby="modes-h">
        <div class="sec-head">
          <h2 id="modes-h">App and fidelity</h2>
          <ul class="sources">
            <li><code>--mode app|fidelity</code></li>
          </ul>
        </div>
        <div class="sec-body">
          <div class="prose">
            <p>
              The same capture compiles two ways. <code>app</code> is the product; <code>fidelity</code> exists so the
              visual gate can check the capture and the drawing without reflow in the way.
            </p>
          </div>
          <div class="modes">
            <div>
              <h3><code>app</code> (default)</h3>
              <ul>
                <li>Native stacks, grids and <code>Text</code> with native line breaking.</li>
                <li>System and custom fonts scale with Dynamic Type (<code>@ScaledMetric</code>, <code>relativeTo:</code>); boxes grow with their text.</li>
                <li>Measured heights on anything that lays out text are floors, not pins. Pages taller than the viewport scroll.</li>
                <li>Reusable: <code>init</code>, <code>ForEach</code> rows, actions, open states, motion.</li>
                <li>ARIA names, values and states reach VoiceOver; <code>autocomplete</code>, <code>inputmode</code>, <code>enterkeyhint</code> pick the keyboard.</li>
              </ul>
            </div>
            <div>
              <h3><code>fidelity</code></h3>
              <ul>
                <li>Keeps the captured geometry and line division at fixed sizes.</li>
                <li>Animations render their settled look.</li>
                <li>Used for visual verification, scored in its own families with their own floors.</li>
              </ul>
            </div>
          </div>
          <div class="prose" style="margin-top: 2rem">
            <p>
              Some patterns keep captured geometry even in <code>app</code> mode and say so in <code>diagnostics</code>:
              flex-wrap and unequal flex growth outside their solvers, grids outside the <code>MarkswiftTracks</code>
              subset, inline-block rows, tables outside the <code>MarkswiftTable</code> subset, and percentage relative
              offsets.
            </p>
          </div>
        </div>
      </section>

      <section class="sec" id="components" aria-labelledby="components-h">
        <div class="sec-head">
          <h2 id="components-h">Components</h2>
          <ul class="sources">
            <li><a href={blob("src/swift/components.ts")}>src/swift/components.ts</a></li>
            <li><a href={blob("src/analysis/naming.ts")}>src/analysis/naming.ts</a></li>
            <li><a href={tree("src/swift/tokens")}>src/swift/tokens/</a></li>
          </ul>
        </div>
        <div class="sec-body">
          <div class="prose">
            <p>
              Repeated sibling elements become a row type, a row subview and a data array iterated with
              <code>ForEach</code>. The screen always has an explicit <code>init</code> whose parameters default to the
              design, in this order: data arrays, annotated fields, actions. Per-row buttons collapse into one
              <code>on&lt;Name&gt;: (Row) -&gt; Void</code> that receives the tapped row.
            </p>
          </div>
          <Evidence slug="tw-cards">
            A Tailwind team-members page converted with <code>--name TeamCards</code>. The two member cards are one
            <code>ForEach</code> over <code>inviteATeammateCards</code>.
          </Evidence>
          <div class="block">
            <span class="label">TeamCards.swift (excerpt; <code>// …</code> marks omitted lines)</span>
            <Code code={teamCards} lang="swift" theme="css-variables" />
          </div>
          <div class="block">
            <span class="label">The row type and the design's rows, in the same file</span>
            <Code code={teamCardsRow} lang="swift" theme="css-variables" />
          </div>
          <div class="block">
            <span class="label">Your code</span>
            <Code code={usage} lang="swift" theme="css-variables" />
          </div>

          <h3>Names</h3>
          <div class="prose">
            <p>
              Names come from the markup, first match wins: <code>data-markswift-component</code>, <code>id</code>,
              <code>data-slot</code>, <code>aria-label</code>, the first non-utility class, else the nearest heading plus
              a tag noun. Fields use <code>data-markswift-field</code>, then <code>data-slot</code> or class, then their
              kind (<code>title</code>, <code>text</code>, <code>isOn</code>, …). Names are API: a rule change renames
              them on regeneration and is noted in the changelog.
            </p>
          </div>
          <div class="block">
            <Code code={naming} lang="html" theme="css-variables" />
          </div>

          <h3>Colour tokens</h3>
          <div class="prose">
            <p>
              With the default adaptive theme every colour that differs between the light and dark capture becomes a
              <code>Color.markswift(light:dark:)</code> token in <code>&lt;Name&gt;.Palette</code>, documented with its
              role, use count and CSS variable.
            </p>
          </div>
          <div class="block">
            <span class="label">TeamCards+Tokens.swift (excerpt)</span>
            <Code code={teamCardsTokens} lang="swift" theme="css-variables" />
          </div>
          <div class="prose">
            <p>
              <code>--palette map.json</code> points tokens at colours your app already has. Keys are a CSS variable, a
              hex colour or a <code>#light/#dark</code> pair; values are Swift <code>Color</code> expressions emitted
              verbatim. Mapped colours are not part of the visual verification.
            </p>
          </div>
          <div class="block">
            <Code code={palette} lang="json" theme="css-variables" />
          </div>

          <h3>Regenerating</h3>
          <div class="prose">
            <p>
              Output is tool-owned. Rerun the same command with <code>--update</code>: it rewrites the files listed in
              <code>.markswift.json</code>, deletes listed files the new output no longer produces, and never touches a
              file it did not write. A hand-edited generated file stops it with exit 2 (<code>--update --force</code>
              discards the edits). Customise through the initializer, <code>--palette</code>, extensions and wrappers in
              your own files.
            </p>
          </div>

          <h3>A component library: <code>markswift build</code></h3>
          <div class="prose">
            <p>
              <code>markswift build [markswift.json]</code> captures every component of a config in one browser session
              and writes one local Swift package (swift-tools 6.2, iOS 18 / macOS 15): one public view per component, one
              module-level <code>Palette</code> shared across them, each webfont once, one runtime. Add it with
              <b>File ▸ Add Package Dependencies ▸ Add Local…</b>, call <code>BundledFonts.register()</code> once at
              launch, then <code>import ShadcnKit</code>.
            </p>
          </div>
          <div class="block">
            <span class="label">markswift.json</span>
            <Code code={library} lang="json" theme="css-variables" />
          </div>
        </div>
      </section>

      <section class="sec" id="two" aria-labelledby="two-h">
        <div class="sec-head">
          <h2 id="two-h">New in 2.0</h2>
          <ul class="sources">
            <li><a href={changelog}>CHANGELOG.md</a></li>
          </ul>
        </div>
        <div class="sec-body">
          <h3>Breakpoints and container queries</h3>
          <div class="prose">
            <p>
              <code>--breakpoints</code> (API <code>breakpoints</code>) captures one LayoutDoc per CSS width band
              (<code>auto</code>: 390, 834×1210, 1210×834, 1376×1032) and emits one view. Elements whose authored inputs
              differ between bands become alternatives chosen at layout time by <code>MarkswiftBands</code> at the width
              SwiftUI offers the view, so there is no first-frame flash; everything else is emitted once and reflows.
              Controls keep one <code>@State</code> across bands. A stack or grid that is a query container
              (<code>container-type</code>) nests its own <code>MarkswiftBands</code> and switches at its own width.
            </p>
          </div>
          <div class="block">
            <Code code={breakpoints} lang="sh" theme="css-variables" />
          </div>
          <Evidence slug="bp-dialog-footer-390">Below the 640 px threshold the footer buttons stack.</Evidence>
          <Evidence slug="bp-dialog-footer-640" wide>From 640 px the same view puts them in a row.</Evidence>
          <div class="block">
            <span class="label">The merged view switches on one edge (DeleteDialog.swift, excerpt)</span>
            <Code code={deleteDialog} lang="swift" theme="css-variables" />
          </div>
          <div class="prose">
            <p>
              Height and orientation media queries are reported, not translated; landscape iPad is a wider width band.
              The <code>@bp</code> captures above come from the iPad breakpoint run and are evidence, not a tracked
              baseline.
            </p>
          </div>

          <h3>Overlays, menus, tooltips, disclosures</h3>
          <div class="prose">
            <p>
              Triggers are found without configuration: ARIA <code>aria-haspopup</code>/<code>aria-expanded</code>,
              native <code>popovertarget</code>, <code>commandfor</code>, <code>interestfor</code> and
              <code>&lt;details&gt;</code>, shadcn <code>data-slot</code>, or
              <code>data-markswift-opens="click|hover|contextmenu"</code> for one the discovery misses. Each is opened in its
              own page, and what it opens is captured.
            </p>
            <ul>
              <li><b>Dialogs, alert dialogs, sheets, popovers, hover cards</b> are drawn with their CSS look behind an init-seeded <code>is&lt;Name&gt;Presented</code>. Escape, an outside tap or the design's own buttons close them (<code>on&lt;Name&gt;Dismissed</code>); modal ones are VoiceOver-modal; hover cards open on long-press.</li>
              <li><b>Disclosures</b> (<code>&lt;details&gt;</code>, collapsible, accordion item) expand in place behind <code>is&lt;Name&gt;Expanded</code>, and the trigger announces expanded or collapsed.</li>
              <li><b>Menus, menubars and selects</b> open native <code>Menu</code>/<code>.contextMenu</code> popups with their captured items.</li>
              <li><b>Tooltips</b> become <code>.help(…)</code> and a VoiceOver hint; nothing visible on iPhone.</li>
            </ul>
          </div>
          <Evidence slug="overlay-dialog-open">
            The shadcn dialog, opened: Chrome with the trigger clicked against the view initialised with
            <code>isEditProfilePresented: true</code>.
          </Evidence>
          <div class="block">
            <span class="label">EditProfile.swift (excerpt)</span>
            <Code code={editProfile} lang="swift" theme="css-variables" />
          </div>

          <h3>Motion and Reduce Motion</h3>
          <div class="prose">
            <p>
              CSS <code>@keyframes</code> play through <code>MarkswiftAnimation</code>: opacity, translate, scale and
              rotate with CSS timing (delay, iterations, direction, fill mode, per-keyframe <code>cubic-bezier()</code>,
              <code>steps()</code>, <code>linear()</code>) on a <code>TimelineView</code> clock that stops once every
              one-shot has ended. Pressed and focused looks animate with the browser's own per-direction transition;
              overlays play their enter and exit keyframes; disclosures grow with their CSS height animation
              (<code>MarkswiftReveal</code>).
            </p>
            <p>
              Under Reduce Motion the author's <code>prefers-reduced-motion</code> rules win. Without them, decorative
              loops stop at rest, one-shots lose their movement and keep their opacity timing, and status indicators
              (<code>role="status"</code>, <code>progressbar</code>, <code>aria-busy</code>) keep turning.
            </p>
          </div>
          <Evidence slug="motion-timing-t250">
            The gate pauses Chrome's animations and the native clock at the same time; this is the frame at 250 ms.
          </Evidence>

          <h3>Tables and grid placement</h3>
          <div class="prose">
            <p>
              Admitted tables (separated or collapsed borders, <code>colspan</code>/<code>rowspan</code>,
              <code>border-spacing</code>, <code>table-layout: fixed</code>) are laid out by <code>MarkswiftTable</code>
              with shared columns, and <code>&lt;th&gt;</code> announces as a header. App-mode grids keep CSS placement
              through <code>MarkswiftTracks</code>: line and span placement, named areas, holes, implicit
              <code>grid-auto-rows</code>, <code>justify-self</code>, when the solvers reproduce the capture within 1 px.
            </p>
          </div>
          <Evidence slug="shadcn-table">The shadcn table fixture.</Evidence>
          <Evidence slug="grid-placement">Spans, named areas, holes, <code>justify-self</code> and a row span.</Evidence>
        </div>
      </section>

      <section class="sec" id="verification" aria-labelledby="verification-h">
        <div class="sec-head">
          <h2 id="verification-h">Verification</h2>
          <ul class="sources">
            <li><a href={blob("tools/quality.ts")}>tools/quality.ts</a></li>
            <li><a href={tree("tools/verify")}>tools/verify/</a></li>
            <li><a href={tree("tests/conformance")}>tests/conformance/</a></li>
          </ul>
        </div>
        <div class="sec-body">
          <div class="prose">
            <p>
              Every conformance fixture is converted, rendered by Chrome and by SwiftUI, and the two images are scored
              with colour SSIM (the minimum over R, G and B) plus pixel mismatch and element-region anchors. The tracked
              iOS baseline holds {totals.all} captures: every fixture at 320 and 390 px, light and dark where it has both,
              in both modes, plus open layers (<code>@open:</code>) and animation frames (<code>@t:</code>).
              {totals.app95} of {totals.app} <code>app</code> captures and {totals.fidelity95} of {totals.fidelity}
              <code>fidelity</code> captures reach SSIM ≥ 0.95.
            </p>
          </div>

          <div class="table-wrap">
            <table>
              <caption>
                iOS visual baseline by family (<a href={blob("tests/conformance/baselines/visual-all-ios.json")}>visual-all-ios.json</a>;
                floors from <a href={blob("tests/conformance/visual-policy-ios.json")}>visual-policy-ios.json</a>)
              </caption>
              <thead>
                <tr>
                  <th scope="col">Family</th>
                  <th scope="col" class="num">Captures</th>
                  <th scope="col" class="num">Mean SSIM</th>
                  <th scope="col" class="num">Min SSIM</th>
                  <th scope="col">Lowest capture</th>
                  <th scope="col" class="num">Floor</th>
                </tr>
              </thead>
              {
                ["app", "fidelity"].map((mode) => (
                  <tbody>
                    <tr class="group"><th scope="rowgroup" colspan="6"><code>{mode}</code> mode</th></tr>
                    {quality
                      .filter((q) => q.mode === mode)
                      .map((q) => (
                        <tr>
                          <th scope="row">{q.domain}</th>
                          <td class="num">{q.n}</td>
                          <td class="num">{q.mean}</td>
                          <td class="num">{q.minValue}</td>
                          <td class="case">{q.minCase}</td>
                          <td class="num">{q.floor?.toFixed(2) ?? "—"}</td>
                        </tr>
                      ))}
                  </tbody>
                ))
              }
            </table>
          </div>

          <div class="prose">
            <ul>
              <li><b>Floors only rise.</b> Each family's floor is raised by <code>bun run quality --ratchet</code> on a reviewed rebaseline and never lowered. A capture also fails if it drops more than {policy.maxDrop} below its baseline or misses an anchor. <code>components@app</code> is held at SSIM ≥ 0.95 per capture except {exceptions} listed exceptions, each with a reason and an owner.</li>
              <li><b>macOS gate on every pull request</b>, rendered with <code>ImageRenderer</code>: the same drop rule, anchors and floors, plus 390-compiled code rendered at 320 and 768 px against fresh Chrome captures. macOS draws text at different heights than iOS, so its numbers are a regression signal, not the support claim.</li>
              <li><b>iOS renderer</b> over all fixtures on release tags and on dispatch, in the simulator ({device}, {iosRuntime}, {xcode}) with <code>UIHostingController</code> and <code>drawHierarchy</code>, so text fields, editors and scroll views are drawn natively.</li>
              <li><b>Breakpoint gate</b>: each breakpoint fixture's merged view is rendered at its band widths and at T−1/T of every CSS width threshold (<code>@bp</code> captures); wide captures use an iPad simulator.</li>
              <li><b>Behaviour harness</b> (<a href={blob("tests/conformance/ios-behaviour.json")}>{behaviour.cases.length} cases</a> in the iOS simulator): accessibility tree and Apple's accessibility audit, Dynamic Type from xSmall to AX5, right-to-left mirroring, interaction (every action closure is called), motion with and without Reduce Motion, every overlay opening and closing, and a breakpoint view switching bands while typed text and a toggled switch keep their values.</li>
              <li><b>Accessibility parity</b> on every pull request: every node Chrome's accessibility tree names in the pilot fixtures keeps its role and name in the converted view.</li>
              <li><b>Frozen LayoutDoc</b>: a test pins the schema to its version; a change to the captured style list or the schema bumps <code>LAYOUT_DOC_VERSION</code> and is a breaking release.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="sec" id="limits" aria-labelledby="limits-h">
        <div class="sec-head">
          <h2 id="limits-h">Limits</h2>
          <ul class="sources">
            <li><a href={`${github}#not-translated`}>README: Not translated</a></li>
            <li><a href={`${github}#known-gaps`}>README: Known gaps</a></li>
          </ul>
        </div>
        <div class="sec-body">
          <div class="prose">
            <p>
              Features outside the measured table may work but are not claimed. Everything the capture loses is reported
              per node in <code>diagnostics</code> as mapped, approximated or unmapped.
            </p>
          </div>
          <ul class="limits">
            <li><b>JavaScript.</b> Behaviour and business logic are not translated; scripts only run in Chrome during capture.</li>
            <li><b>Media queries.</b> Height and orientation queries are reported. Without <code>--breakpoints</code> there is one viewport and one layout per capture; a fixed-width root gets no breakpoints.</li>
            <li><b>States.</b> Pressed, focused and open are captured. Other hover-only states, disabled, validation, checked and <code>data-state</code> variants are not.</li>
            <li><b>Overlays.</b> No swipe-to-dismiss or system presentation chrome, no collision flip, scroll lock or focus trap beyond VoiceOver's modal containment. Nested triggers are not opened.</li>
            <li><b>Menus.</b> Native popups: the open list's CSS look, shortcut text, item icons and submenus are not drawn (a submenu is a disabled entry).</li>
            <li><b>Tooltips.</b> Never drawn: <code>.help(…)</code> and a VoiceOver hint.</li>
            <li><b>Motion.</b> Scroll-driven animations, keyframed colours, shadows, filters and layout properties, <code>@starting-style</code> and script animations are reported, not played.</li>
            <li><b>Layout.</b> <code>position: sticky</code> stays at rest. Bare text beside a float is not split around it. <code>&lt;select multiple&gt;</code> and <code>&lt;datalist&gt;</code> are not translated.</li>
            <li><b>Fonts.</b> <code>ui-monospace</code> maps to SF Mono, which is wider than Chrome's Menlo; on system fonts <code>font-stretch</code> snaps to SF's nearest width.</li>
            <li><b>Tables.</b> VoiceOver table navigation (row and column position, header association) is not translated.</li>
            <li><b>Visual gate.</b> {exceptions} of the {componentsApp.length} <code>components@app</code> iOS captures are listed exceptions: fractional line boxes rounded to the pixel grid, iOS line breaking that avoids a one-word last line, <code>ui-monospace</code> drawn in SF Mono.</li>
          </ul>
        </div>
      </section>
    </main>

