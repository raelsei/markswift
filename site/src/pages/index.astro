---
import Book from "../layouts/Book.astro";
import Spread from "../components/Spread.astro";
import { artifactRevision, run, version, type Row } from "../lib/book";
import html from "../artifacts/hello.html?raw";
import swift from "../artifacts/HelloCard.swift?raw";
import transcript from "../artifacts/transcript.txt?raw";

const rows: Row[] = [
  ["## hello.html", "## HelloCard.swift"],
  ["<main data-markswift-root", "struct HelloCard: View {"],
  [`      style="width:240px;height:80px;font:18px system-ui">`, "    @ScaledMetric(relativeTo: .body) private var textSize18: CGFloat = 18.0"],
  ["", "    init() {}"],
  ["", "    var body: some View {"],
  [
    "  Hello Markswift",
    `        Text(verbatim: "Hello Markswift").font(.system(size: textSize18, weight: .regular, design: .default)).foregroundStyle(Color.markswift(0.0, 0.0, 0.0))`,
  ],
  ["", "        .fixedSize(horizontal: false, vertical: true)"],
  ["", "        .frame(minWidth: 0.0, maxWidth: .infinity, minHeight: 80.0, maxHeight: .infinity, alignment: .topLeading)"],
  ["</main>", "    }"],
  ["", "}"],
  ["", `#Preview("HelloCard — Light") {`],
  ["", "    HelloCard()"],
  ["", "    .frame(width: 240.0, height: 80.0)"],
  ["", "    // …"],
];

const notes: Array<[number | number[] | string, string]> = [
  [1, "The element marked <code>data-markswift-root</code> becomes the view; <code>--name HelloCard</code> names it."],
  [2, "<code>font:18px system-ui</code> becomes an 18-point system size that scales with Dynamic Type."],
  [5, "The text keeps its words as written, <code>Text(verbatim:)</code>, with the weight and colour Chrome computed."],
  [7, "<code>height:80px</code> becomes a floor, <code>minHeight: 80.0</code>: in app mode the box grows with its text."],
  [12, "<code>width:240px</code> sizes the preview only; the view fills the width it is offered (line 7)."],
  ["Losses", "None. This run reported nothing <span class=\"lv\">approximated</span> or <span class=\"lv\">unmapped</span>; chapter 9 shows a run that does."],
];
---

<Book at={0} description="How Markswift turns rendered HTML and CSS into SwiftUI, one stage per chapter, set as a parallel text.">
  <header class="opening">
    <div class="lede">
      <h1><span class="no">1</span>How Markswift turns a rendered page into SwiftUI</h1>
      <p>
        Markswift opens your HTML and CSS in Chrome, writes down what the browser actually laid out, and turns that
        record into SwiftUI for iOS 18+ and Swift 6 that looks like the browser’s rendering.
      </p>
      <p>
        This edition sets each step as a spread: its input on the left page, its output on the right, with shared line
        numbers. Point at a number, or tab to it, to light the line on both pages and its note in the apparatus. Every
        excerpt is verbatim Markswift {version} input or output; <code>…</code> and <code>// …</code> mark cuts.
        Below is the README’s one-line card; chapters 2 to 6 follow a slightly larger one through every stage.
      </p>
    </div>
    <aside class="provenance" aria-labelledby="set-from">
      <h2 id="set-from" class="sc">Set from</h2>
      <pre><code>{run(transcript, "npx markswift convert hello.html --name HelloCard --out ./generated-hello")}</code></pre>
      <p>
        <code>hello.html</code> is the README’s quick-start markup on four lines. Every run in this book was made from
        a checkout at <code>{artifactRevision}</code>, where <code>bun src/cli.ts</code> stands for
        <code>npx markswift</code>.
      </p>
    </aside>
  </header>

  <Spread
    id="overview"
    verso={{ label: "HTML · verso", note: "what you wrote", sources: { "hello.html": html } }}
    recto={{ label: "SwiftUI · recto", note: "what Markswift wrote", sources: { "HelloCard.swift": swift } }}
    rows={rows}
    notes={notes}
  />
</Book>
