---
import Book from "../layouts/Book.astro";
import Spread from "../components/Spread.astro";
import { artifactRevision, chapters, lemma, runEntry, type Row } from "../lib/book";
import html from "../artifacts/hello.html?raw";
import swift from "../artifacts/HelloCard.swift?raw";
import transcript from "../artifacts/transcript.txt?raw";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// Chapters 2 to 7 are the stages, in pipeline order, each with the source it lives in.
const sources = ["src/browser/", "src/model/layout.ts", "src/analysis/", "src/swift/", "src/swift/runtime/", "tools/quality.ts"];
const stages = sources.map((path, i) => ({ path, no: i + 2, ...chapters[i + 1]! }));

const rows: Row[] = [
  ["## hello.html", "## HelloCard.swift"],
  ["<main data-markswift-root", "struct HelloCard: View {"],
  [`      style="width:240px;height:80px;font:18px system-ui">`, "    @ScaledMetric(relativeTo: .body) private var textSize18: CGFloat = 18.0"],
  ["", "    init() {}"],
  ["", "    var body: some View {"],
  [
    "  Hello Markswift",
    `        Text(verbatim: "Hello Markswift").font(.system(size: textSize18, weight: .regular, design: .default)).foregroundStyle(Color.markswift(0.0, 0.0, 0.0))`,
  ],
  ["", "        .fixedSize(horizontal: false, vertical: true)"],
  ["", "        .frame(minWidth: 0.0, maxWidth: .infinity, minHeight: 80.0, maxHeight: .infinity, alignment: .topLeading)"],
  ["</main>", "    }"],
  ["", "}"],
  ["", `#Preview("HelloCard — Light") {`],
  ["", "    HelloCard()"],
  ["", "    .frame(width: 240.0, height: 80.0)"],
  ["", "    // …"],
];

const notes: Array<[number | number[] | string, string]> = [
  [1, lemma("<code>data-markswift-root</code>", "the view; <code>--name HelloCard</code> names it")],
  [2, lemma("<code>font:18px system-ui</code>", "<code>@ScaledMetric</code> 18 pt, follows Dynamic Type")],
  [5, lemma("<code>Hello Markswift</code>", "<code>Text(verbatim:)</code>, words as written, Chrome’s weight and colour")],
  [7, lemma("<code>height:80px</code>", "<code>minHeight: 80.0</code>, a floor: the box grows with its text")],
  [12, lemma("<code>width:240px</code>", "the preview frame only; the view fills its width (7)")],
  ["Losses", lemma("<span class=\"lv\">approximated</span>, <span class=\"lv\">unmapped</span>", "none in this run; chapter 9 has five")],
  [
    "Run",
    runEntry(
      transcript,
      "npx markswift convert hello.html --name HelloCard --out ./generated-hello",
      `; checkout <code>${artifactRevision}</code>, <code>bun src/cli.ts</code> for <code>npx markswift</code>; the README’s quick-start markup on four lines`,
    ),
  ],
];
---

<Book at={0} description="How Markswift turns rendered HTML and CSS into SwiftUI, one stage per chapter, set as a parallel text.">
  <header class="opening">
    <div class="lede">
      <h1><span class="no">1</span>How Markswift turns a rendered page into SwiftUI</h1>
      <p>
        Markswift opens your HTML and CSS in Chrome, writes down what the browser actually laid out, and turns that
        record into SwiftUI for iOS 18+ and Swift 6 that looks like the browser’s rendering. Each chapter sets one stage
        as a spread, its input on the left page and its output on the right; chapters 2 to 6 follow one small card
        through all of them.
      </p>
    </div>
    <nav class="stages" aria-labelledby="stages">
      <h2 id="stages" class="sc">The six stages</h2>
      <ol>
        {
          stages.map((s) => (
            <li>
              <a href={`${base}${s.slug}`}>
                <span class="no">{s.no}</span>
                <span class="t">{s.title}</span>
                <code>{s.path}</code>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </header>

  <Spread
    id="overview"
    verso={{ label: "HTML · verso", note: "what you wrote", sources: { "hello.html": html } }}
    recto={{ label: "SwiftUI · recto", note: "what Markswift wrote", sources: { "HelloCard.swift": swift } }}
    rows={rows}
    notes={notes}
    lit={5}
  />
</Book>
