---
import Book from "../layouts/Book.astro";
import Spread from "../components/Spread.astro";
import { esc, github, lemma, run, type Row } from "../lib/book";
import html from "../artifacts/inbox.html?raw";
import swift from "../artifacts/InboxNote.swift?raw";
import transcript from "../artifacts/transcript.txt?raw";

const command = "npx markswift convert inbox.html --name InboxNote --theme light --out ./generated-inbox";
const printed = run(transcript, command).split("\n");
/** The run's own note for one feature, verbatim. */
const note = (feature: string) => {
  const line = printed.find((l) => l.startsWith("Note ") && l.includes(` ${feature}: `));
  if (!line) throw new Error(`no ${feature} note in the inbox run`);
  return `<code>${esc(line)}</code>`;
};

const rows: Row[] = [
  ["## inbox.html", "## InboxNote.swift"],
  [`<section data-markswift-root style="width:320px;font:16px system-ui">`, "        VStack(alignment: .leading, spacing: 0.0) {"],
  [
    `  <h3 style="position:sticky;top:0">Inbox</h3>`,
    `            Text(verbatim: "Inbox").font(.system(size: textSize18_72, weight: .bold, design: .default)).foregroundStyle(Palette.textBlack)`,
  ],
  ["", "            // …"],
  [`  <p>Reply <span onclick="reply()">now</span>.</p>`, "            Text.markswiftRuns(["],
  ["", `                Text(verbatim: "Reply ").font(.system(size: textSize16, weight: .regular, design: .default)).foregroundStyle(Palette.textBlack),`],
  ["", `                Text(verbatim: "now").font(.system(size: textSize16, weight: .regular, design: .default)).foregroundStyle(Palette.textBlack),`],
  ["", "                // …"],
  [
    `  <p style="writing-mode:vertical-rl">Ab</p>`,
    `            Text(verbatim: "Ab").font(.system(size: textSize16, weight: .regular, design: .default)).foregroundStyle(Palette.textBlack)`,
  ],
  ["", "            // …"],
  [`  <div style="display:flex;flex-wrap:wrap;gap:8px">`, "            v_3"],
  ["", "            // …"],
  ["", "    private var v_3: some View {"],
  ["", "        MarkswiftMeasuredLayout(width: 320.0, height: 44.0, frames: ["],
  [`    <b style="flex:1 0 120px">One</b>`, "            CGRect(x: 0.0, y: 0.0, width: 154.0, height: 18.0),"],
  [`    <b style="flex:2 0 90px">Two</b>`, "            CGRect(x: 162.0, y: 0.0, width: 158.0, height: 18.0),"],
  [`    <b style="flex:1 0 140px">Three</b>`, "            CGRect(x: 0.0, y: 26.0, width: 320.0, height: 18.0),"],
  ["  </div>", "        ], grows: true) {"],
  ["</section>", "        // …"],
];

const notes: Array<[number | number[] | string, string]> = [
  [2, lemma("<code>position:sticky</code>", `${note("position: sticky")}; drawn where captured, never pinned`)],
  [[4, 6], lemma("<code>onclick</code>", `${note("@onclick")}; the words stay, the tap goes`)],
  [8, lemma("<code>writing-mode:vertical-rl</code>", `${note("writing-mode")}; drawn horizontally`)],
  [[10, 13, 17], lemma("<code>flex-wrap:wrap</code>", `${note("flex-wrap")}`)],
  [[14, 15, 16], lemma("<code>flex:1</code>, <code>2</code>, <code>1</code>", `${note("flex-grow")}`)],
  ["Levels", lemma("<span class=\"lv\">approximated</span>, <span class=\"lv\">unmapped</span>", "drawn with a stated loss; not reproduced. Brackets list node ids: <code>3/0</code>, node 3’s first child")],
  ["Run", lemma(`<code>$ ${esc(command)}</code>`, `<code>${esc(printed[1]!)}</code>, then the five notes above`)],
  ["More", lemma("README", `<a href="${github}#not-translated">Not translated</a>, <a href="${github}#known-gaps">Known gaps</a>`)],
];
---

<Book at={8} description="Limits: what Markswift does not translate, and how every loss is reported as a note per node.">
  <header class="opening">
    <div class="lede">
      <h1><span class="no">9</span>Limits: what it says it lost</h1>
      <p>
        Markswift translates what Chrome laid out, not what scripts do: JavaScript runs only during capture. It does
        not translate height or orientation media queries, width breakpoints without <code>--breakpoints</code>,
        validation states, hover-only states beyond tooltips and hover cards, sticky pinning, scroll-driven animations or <code>&lt;select
        multiple&gt;</code>. Some layouts keep their captured geometry in app mode instead of reflowing.
      </p>
      <p>
        Nothing is lost silently. Every loss is printed as a note naming its level, its feature and its nodes, and the
        library returns the same list as <code>diagnostics</code>. The page on the left was written to trip five of
        them.
      </p>
    </div>
  </header>

  <Spread
    id="limits"
    verso={{ label: "HTML · verso", note: "written to lose", sources: { "inbox.html": html } }}
    recto={{ label: "SwiftUI · recto", note: "what came through", sources: { "InboxNote.swift": swift } }}
    rows={rows}
    notes={notes}
    lit={8}
  />
</Book>
