---
import Book from "../layouts/Book.astro";
import Spread from "../components/Spread.astro";
import { lemma, type Row } from "../lib/book";
import layout from "../artifacts/WelcomeCard.layout.json?raw";
import ir from "../artifacts/WelcomeCard.ir.json?raw";

const rows: Row[] = [
  ["## WelcomeCard.layout.json", "## WelcomeCard.ir.json"],
  [`"tag": "article",`, `"id": "root",`],
  ["…", "…"],
  ["", `"padding": [`],
  ["", "  24,"],
  ["", "  24,"],
  [`  "padding-bottom": "24px",`, "  40,"],
  ["", "  24"],
  ["", "],"],
  ["…", "…"],
  ["", `"confidence": "mapped",`],
  ["", `"diagnostics": [],`],
  ["", "…"],
  [`  "tag": "h2",`, `"kind": "stack",`],
  ["  …", `"axis": "v",`],
  [`    "margin-bottom": "19.92px",`, `"spacing": 19.9,`],
  ["    …", "…"],
  [`    "margin-top": "19.92px",`, `"leadInset": 19.91,`],
  ["  …", `"children": [`],
  ["", "  {"],
  ["", `    "id": "0",`],
  [`  "bounds": {`, `    "frame": {`],
  [`    "x": 24,`, `      "x": 24,`],
  [`    "y": 43.91,`, `      "y": 43.91,`],
  [`    "w": 320,`, `      "w": 320,`],
  [`    "h": 28`, `      "h": 28`],
  ["  …", "    …"],
  ["", `    "a11y": {`],
  ["", `      "heading": 2`],
  ["", "    },"],
  ["", "    …"],
  ["", `    "kind": "text",`],
  ["", `    "sourceTag": "h2",`],
  ["", "    …"],
  [`      "text": "Hello SwiftUI",`, `        "text": "Hello SwiftUI",`],
  ["  …", "    …"],
  [`  "tag": "p",`, `    "id": "1",`],
  ["  …", "    …"],
  [`    "margin-bottom": "16px",`, ""],
  ["  …", ""],
  [`    "y": 91.81,`, `      "y": 91.81,`],
  ["  …", "    …"],
  ["", `    "kind": "text",`],
  ["", `    "sourceTag": "p",`],
];

const notes: Array<[number | number[] | string, string]> = [
  [[1, 20, 36], lemma("each element", "one node, same id: <code>root</code>, <code>0</code>, <code>1</code>")],
  [[6, 38], lemma("24 px padding + 16 px margin", "bottom padding 40")],
  [[10, 11], lemma("losses", "none listed; confidence <span class=\"lv\">mapped</span>")],
  [[13, 14], lemma("blocks, top to bottom", "a vertical stack")],
  [15, lemma("19.92 px and 16 px margins", "collapsed by CSS; the 19.9 px gap Chrome drew is the spacing")],
  [17, lemma("<code>margin-top</code> through the padded card", "an offset padding does not explain: lead inset 19.91")],
  [[21, 23], lemma("<code>bounds</code>", "<code>frame</code>, kept for verification and as a fallback")],
  [[27, 28], lemma("<code>&lt;h2&gt;</code>", "a level-2 heading for assistive technology")],
  [[31, 32, 42, 43], lemma("<code>&lt;h2&gt;</code>, <code>&lt;p&gt;</code>", "text nodes that keep their tag")],
  [34, lemma("<code>Hello SwiftUI</code>", "unchanged; the run records system font, 24 px, 700, colour")],
  ["Run", lemma("<code>inferScreen(r.layout, \"WelcomeCard-light\")</code>", "<code>src/analysis/infer.ts</code>, inside every conversion, not public API; written out by <code>recompile.ts</code>")],
];
---

<Book at={3} description="Semantic IR: how Markswift reads measured boxes as stacks, text and controls before any SwiftUI is written.">
  <header class="opening">
    <div class="lede">
      <h1><span class="no">4</span>Semantic IR: what the boxes mean</h1>
      <p>
        Analysis reads the LayoutDoc and writes down what the design means, with no SwiftUI vocabulary yet: stacks,
        grids, text, controls. It works from measured boxes rather than CSS rules, so the gaps it records are the ones
        Chrome actually drew.
      </p>
      <p>
        Every node keeps its frame, its capture id and a confidence: <span class="lv">mapped</span>,
        <span class="lv">approximated</span> or <span class="lv">unmapped</span>, the worst of the losses listed
        beside it. Those lists are what the CLI prints as notes. Here two margins and a padding become one vertical
        stack.
      </p>
    </div>
  </header>

  <Spread
    id="ir"
    verso={{ label: "LayoutDoc · verso", note: "measured boxes", sources: { "WelcomeCard.layout.json": layout } }}
    recto={{ label: "Semantic IR · recto", note: "what they mean", sources: { "WelcomeCard.ir.json": ir } }}
    rows={rows}
    notes={notes}
    lit={15}
  />
</Book>
