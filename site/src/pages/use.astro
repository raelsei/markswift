---
import Book from "../layouts/Book.astro";
import Spread from "../components/Spread.astro";
import { artifactRevision, github, type Row } from "../lib/book";
import transcript from "../artifacts/transcript.txt?raw";
import config from "../artifacts/markswift.json?raw";
import pkg from "../artifacts/Package.swift?raw";

// The recorded terminal, split into what was typed and what came back.
const lines = transcript.trimEnd().split("\n");
const shell = lines.filter((l) => l.startsWith("$ ")).join("\n");
const output = lines.filter((l) => !l.startsWith("$ ")).join("\n");

const hello = "$ npx markswift convert hello.html --name HelloCard --out ./generated-hello";
const rows: Row[] = [
  ["## shell", "## output"],
  ["$ npx markswift --version", "2.0.0"],
  [hello, "Wrote 3 files for HelloCard to ./generated-hello"],
  [`${hello} --update`, "Updated 3 files for HelloCard in ./generated-hello"],
  ["$ npx markswift convert welcome.html --name WelcomeCard --out ./generated-welcome", "Wrote 3 files for WelcomeCard to ./generated-welcome"],
  ["$ npx markswift convert inbox.html --name InboxNote --theme light --out ./generated-inbox", "Wrote 3 files for InboxNote to ./generated-inbox"],
  ["", "…"],
  ["$ npx markswift build markswift.json", "Wrote 5 files for CardKit (2 components) to /private/tmp/ms-src/CardKit"],
  ["", "…"],
  [
    `${hello} --update`,
    "Refusing to overwrite hand-edited files in /private/tmp/ms-src/generated-hello: HelloCard.swift. Move your changes into your own files (Markswift never touches files it did not write) or rerun with --force to discard them.",
  ],
  ["", "exit 2"],
  ["## markswift.json", "## CardKit/Package.swift"],
  ["{", "// swift-tools-version: 6.2"],
  ["", "// …"],
  ["", "let package = Package("],
  [`  "library": "CardKit",`, `    name: "CardKit",`],
  [`  "out": "CardKit",`, "    platforms: [.iOS(.v18), .macOS(.v15)],"],
  [`  "theme": "light",`, `    products: [.library(name: "CardKit", targets: ["CardKit"])],`],
  [`  "components": [`, "    targets: ["],
  [`    { "name": "WelcomeCard", "source": "welcome.html" },`, "    // …"],
  [`    { "name": "InboxNote", "source": "inbox.html" }`, ""],
  ["  ]", ""],
  ["}", ""],
];

const notes: Array<[number | number[] | string, string]> = [
  [1, "The version every generated file’s header carries."],
  [2, "<code>--out</code> must not exist yet. Three files: the view, its <code>+Tokens</code> palette and the runtime, plus the <code>.markswift.json</code> manifest."],
  [3, "<code>--update</code> rewrites the files the manifest lists and never touches a file it did not write."],
  [[5, 6], "Losses go to stderr as notes; chapter 9 reads them."],
  [[7, 8], "One browser session for every component of the config, one Swift package, notes per component."],
  [[9, 10], "After a line was added to <code>HelloCard.swift</code> by hand, <code>--update</code> refuses and exits 2 (the status echoed by the shell); <code>--update --force</code> discards the edit."],
  [[11, 14, 15, 16], "A local Swift package: tools 6.2, iOS 18 and macOS 15, one library product. Add it with File › Add Package Dependencies › Add Local…"],
  [[18, 19], "One public view per component in <code>Sources/CardKit/</code>, beside one shared <code>MarkswiftPalette.swift</code> and runtime."],
  ["Modes", "Compiled in <code>fidelity</code> mode (<code>--mode fidelity</code>), the same card gets <code>.font(.system(size: 24.0, …))</code> and <code>.frame(height: 28.0, …)</code> where app mode writes <code>textSize24</code> and lets the text grow."],
  ["Xcode", "Add every generated <code>.swift</code> file to one target; add <code>Fonts/</code> and <code>Images/</code> as resources when a conversion writes them."],
  ["API", `<code>convert</code>, <code>convertHtml</code>, <code>compileLayout</code> and <code>buildLibrary</code> do the same from code; see the <a href="${github}#library-api">README</a>.`],
];
---

<Book at={7} description="Use Markswift: install, convert, regenerate with --update, build a Swift package with markswift build, and choose app or fidelity mode.">
  <header class="opening">
    <div class="lede">
      <h1><span class="no">8</span>Use it</h1>
      <p>
        Install Markswift as a dev dependency. It needs Node 20 or Bun and Google Chrome; Xcode only to compile the
        result. <code>convert</code> writes one directory per component, and that directory is tool-owned: rerun with
        <code>--update</code> instead of editing it, and customise through the generated <code>init</code>, extensions
        and your own files.
      </p>
      <p>
        <code>markswift build</code> captures every component of a <code>markswift.json</code> in one browser session
        and writes one local Swift package. Output defaults to <code>app</code> mode, the product;
        <code>fidelity</code> pins the captured geometry and exists for verification.
      </p>
    </div>
    <aside class="provenance" aria-labelledby="set-from">
      <h2 id="set-from" class="sc">Install</h2>
      <pre><code>npm install --save-dev markswift</code></pre>
      <p>
        The terminal on the spread is a recording: each command ran as <code>bun src/cli.ts</code> in a checkout at
        <code>{artifactRevision}</code>, which the README gives as the stand-in for <code>npx markswift</code>.
      </p>
    </aside>
  </header>

  <Spread
    id="use"
    verso={{ label: "Input · verso", note: "what you type", sources: { shell, "markswift.json": config } }}
    recto={{ label: "Output · recto", note: "what comes back", sources: { output, "CardKit/Package.swift": pkg } }}
    rows={rows}
    notes={notes}
  />
</Book>
