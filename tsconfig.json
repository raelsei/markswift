{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun-types"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/helpers/**/*.ts",
    "tests/architecture/**/*.ts",
    "tests/integration/**/*.ts",
    "tools/quality.ts",
    "tools/verify/typecheck.ts",
    "tools/verify/visual.ts",
    "tools/verify/visual-native.ts",
    "tools/verify/visual-fixtures.ts",
    "tools/verify/visual-metrics.ts"
  ]
}
