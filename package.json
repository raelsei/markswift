{
  "name": "markswift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test tests/unit tests/architecture tests/integration",
    "quality": "bun run tools/quality.ts",
    "test:browser": "MARKSWIFT_BROWSER_TESTS=1 bun test tests/integration",
    "test:native": "MARKSWIFT_SWIFT_TESTS=1 bun test tests/integration/swift.test.ts",
    "test:unit": "bun test tests/unit",
    "test:architecture": "bun test tests/architecture"
  },
  "dependencies": {
    "domhandler": "^5.0.3",
    "htmlparser2": "^9.1.0",
    "playwright-core": "^1.55.0",
    "svgpath": "^2.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./compiler": "./src/compiler/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "docs"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "description": "Measured HTML and CSS to native SwiftUI components"
}
